<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jobbuilder.project.myPageWorker.model.mapper.MyPageWorkerMapper">

	<!-- 닉네임 중복 검사 -->
	 <select id="checkNickname" resultType="_int">
	 	SELECT COUNT(*)
		FROM "WORKER"
		JOIN "MEMBER" USING (MEMBER_NO)
		WHERE MEMBER_DEL_FL = 'N'
		AND WORKER_NICKNAME = #{workerNickname}
	 </select>
	 
	 <!-- 연락처 중복검사 -->
	 <select id="checkMemberTel" resultType="_int">
	 	SELECT COUNT(*)
		FROM "MEMBER"
		WHERE MEMBER_DEL_FL = 'N'
		AND MEMBER_TEL = #{memberTel}
	 </select>
	 
	 <!-- 비밀번호 가져오기 -->
	<select id="checkPwSet" resultType="String">
    SELECT MEMBER_PW
    FROM "MEMBER"
    WHERE MEMBER_NO = #{memberNo}
	</select>
	
	<!-- 비밀번호 변경 -->
	<update id="workerChangePw">
		UPDATE "MEMBER" SET
		MEMBER_PW = #{encPw}
		WHERE MEMBER_NO = #{memberNo}
	</update>
	
	
</mapper>
